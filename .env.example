APP_NAME="Kilakodon Services"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Développement : `php artisan serve` (PHP 8.2). Avec Herd/Laragon : http://kilakodon-hub.test
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
KH_DISPLAY_TIMEZONE=Africa/Bamako

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kilakodon_hub
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=kh_

# Sessions de 8 h (TRD §11)
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=kh

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="kilakodon@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AI_ENABLED=true
AI_DRIVER=fake            # fake | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

KH_WHATSAPP_PRIMARY=+22374666489
KH_WHATSAPP_SECONDARY=+22397462839
KH_CONTACT_EMAIL=kilakodon@gmail.com

VITE_APP_NAME="${APP_NAME}"

# Développement local uniquement : secret MFA de admin@kilakodon.test, restauré par le DevSeeder après migrate:fresh
KH_DEV_ADMIN_MFA_SECRET=
