# .env de PRODUCTION — Kilakodon Hub (www.kilakodon-services.com, LWS Perso)
#
# Copié automatiquement par deploy/kh-deploy.php vers ~/home/kilakodon-hub/shared/.env (hors htdocs).
# À compléter UNIQUEMENT sur le serveur (gestionnaire de fichiers LWS ou `nano` dans le Terminal).
# Ne jamais envoyer ce fichier rempli par e-mail, chat ou Git.
# Les lignes « À REMPLIR » sont les seules à modifier.

APP_NAME="Kilakodon Services"
APP_ENV=production
# Généré sur le serveur par : php artisan key:generate (le script le fait pour vous).
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.kilakodon-services.com
APP_TIMEZONE=UTC
KH_DISPLAY_TIMEZONE=Africa/Bamako

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base de données — panneau LWS « MySql & PhpMyadmin »
DB_CONNECTION=mysql
# À REMPLIR : serveur MySQL indiqué par LWS (souvent un nom du type xxx.lwsdb… ou localhost)
DB_HOST=
DB_PORT=3306
# À REMPLIR
DB_DATABASE=
# À REMPLIR
DB_USERNAME=
# À REMPLIR (entre guillemets s'il contient des caractères spéciaux)
DB_PASSWORD=
DB_PREFIX=kh_

# Sessions de 8 h (TRD §11), cookie réservé au HTTPS
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=kh

# E-mails — boîte contact@kilakodon-services.com (panneau LWS « Emails »)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
# À VÉRIFIER dans la fiche de la boîte LWS (serveur SMTP sortant)
MAIL_HOST=mail.kilakodon-services.com
MAIL_PORT=465
MAIL_USERNAME=contact@kilakodon-services.com
# À REMPLIR : mot de passe de la boîte contact@
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@kilakodon-services.com"
MAIL_FROM_NAME="${APP_NAME}"

# Assistant IA : reste coupé dans l'admin tant que la base de connaissances n'est pas approuvée.
# Budgets : 0,50 $/jour et 1 $/mois (D-023, D-026), réglables dans Réglages → Paramètres.
AI_ENABLED=true
AI_DRIVER=anthropic
# À REMPLIR : clé API Anthropic de production
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

KH_WHATSAPP_PRIMARY=+22374666489
KH_WHATSAPP_SECONDARY=+22397462839
KH_CONTACT_EMAIL=contact@kilakodon-services.com

# Proxy LWS : laisser vide sauf indication contraire (voir RUNBOOK, mise en production).
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
